# ── Unity üretilen çıktılar (commit edilmemeli) ───────────────────────────────
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
MemoryCaptures/
Recordings/

# ── Önemli: aşağıdakiler commit EDİLMELİ ─────────────────────────────────────
# ProjectSettings/   ← Unity proje ayarları (IL2CPP, ARM64, paket adı, sahne listesi)
# Assets/Scenes/     ← sahne dosyaları
# Assets/Settings/   ← URP Pipeline asset
# Assets/TextMesh Pro/ ← TMP Essential Resources
# **/*.meta          ← GUID tutarlılığı için zorunlu

# ── IDE ───────────────────────────────────────────────────────────────────────
.vs/
.vscode/
*.csproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.unityproj

# ── OS ────────────────────────────────────────────────────────────────────────
[Tt]humbs.db
*.swp
*~
.DS_Store

# ── Derleme çıktıları (CI artifact olarak yüklenir, commit edilmez) ───────────
*.apk
*.aab
*.unitypackage
*.app

# ── Test çıktıları ────────────────────────────────────────────────────────────
*-results.xml
*.log
!Assets/**/*.log

